[Unit]
Description=Bee - Ethereum Swarm node
Documentation=https://docs.ethswarm.org
After=network.target

[Service]
EnvironmentFile=-/etc/default/bee
NoNewPrivileges=true
User=bee
Group=bee
ExecStart=/usr/bin/bee start --config /etc/bee/bee.yaml
Restart=always
RestartSec=5s
# 78 is EX_CONFIG: the node exits with it when a configuration value is invalid.
# A restart cannot change the file, so restarting only loops every RestartSec
# while systemctl is-active still reports active, and buries the one log line
# naming the bad value under a fresh shutdown sequence each time. Measured on a
# real node before this: NRestarts reached 11 from one unquoted YAML value.
# With this, the unit goes to failed and systemctl status says why.
# Every other failure keeps exiting non-zero and keeps restarting (issue #490):
# 1 for a fault, 75 for a paused postage contract or postage-stall-shutdown
# (issue #583).
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
